# Public hostname pointing at this server (Caddy obtains a TLS certificate for it).
DOMAIN=wherempsstand.com
# Other names pointing at this server; each redirects permanently to DOMAIN (comma-separated).
REDIRECT_DOMAINS="www.wherempsstand.com, wheretheystand.uk, www.wheretheystand.uk, wheretheystand.co.uk, www.wheretheystand.co.uk, wheretheystand.org.uk, www.wheretheystand.org.uk"
# The charity's other sites on this server, served by this site's web server: "domain=container" pairs, the container
# being the site's app on the shared "sites" network. Each is served once its certificate is added
# (bash /opt/hansardgpt/deploy/cloudflare.sh site DOMAIN). See "Other sites on this server" in docs/HOSTING.md.
SITES="wherecountriesstand.com=wherecountriesstand wherecouncilsstand.com=wherecouncilsstand"
# Anthropic API key for written answers (ANTHROPIC_API_KEY also works).
# Without it the app shows ranked, cited sources only.
HANSARD_ANTHROPIC_API_KEY=
# Secret for the admin endpoints (/api/admin/usage, /api/admin/sync); generate with: openssl rand -hex 24
HANSARD_ADMIN_TOKEN=
# Optional: a different donations page from the one in config/settings.toml (https://ko-fi.com/wheretheystand).
HANSARD_DONATE_URL=

# Off-site copies of the nightly backup (Backblaze B2): a private bucket and a key limited to it.
# Set these with the command in docs/HOSTING.md ("Setting up the off-site copy") rather than by hand.
HANSARD_B2_BUCKET=
HANSARD_B2_KEY_ID=
HANSARD_B2_APPLICATION_KEY=

# Companies House public data API key (free), for members' company roles. Set it with the command in
# docs/HOSTING.md rather than by hand; without it, company roles are simply not collected.
HANSARD_COMPANIES_HOUSE_KEY=
